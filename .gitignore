# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# local data (the app stores real data in ~/Library/Application Support/ParcelWidget, on Windows %APPDATA%\ParcelWidget)
*.db
*.log
config.json
browser-profile/

# macOS
.DS_Store

# raw image generations kept for re-assembling custom skins
ui/skins/*/_work/

# packaged app (packaging/build_mac.sh)
build/
dist/
packaging/icon.png
packaging/icon.icns
packaging/icon.ico

# credentials / secrets — never commit these
# (CodeBuddy CLI writes ~/.codebuddy/.credentials.json; the app keeps its
#  sign-in in local_storage. Both are outside this repo, but keep a guard here
#  in case a copy or an exported token ever lands next to the source.)
.env
.env.*
!.env.example
.credentials.json
*.credentials.json
credentials.json
*credential*.json
*token*.json
*secret*.json
auth.json
*auth*.json
*.pem
*.p12
*.pfx
*.key
*.keystore
.npmrc
local_storage/
*.info
*.bak

# machine-specific login helpers (contain absolute C:\Users\... paths)
CodeBuddy-*.cmd
